extends Node2D

const CELDA = 24

const MAPA = [
	"................................",
	"......................#######...",
	"......................#.....###.",
	".....#########.....####.......#.",
	".....#.......#######..........#.",
	".....#........................#.",
	"...###........................#.",
	"...#..........................#.",
	"...#..........................#.",
	"...#..........................#.",
	"...#..........................#.",
	"...#..........................#.",
	"...#.............######.......#.",
	"...#...........###....#.......#.",
	"...#.........###......#.......#.",
	"...#.........#........#.......#.",
	".###.........#........#.......#.",
	".#...........#.########.......#.",
	".#...........#.#..............#.",
	".#####.......#.###............#.",
	".....#.......#...#............#.",
	".....#########...#...........##.",
	".................#..........##..",
	".................############...",
	"................................"
]

var pared_escena = preload("res://pared.tscn")

func _ready():
	for fila in MAPA.size():
		for col in MAPA[fila].length():
			var tipo = MAPA[fila][col]
			var posicion_global = Vector2(col + 0.5, fila + 0.5) * CELDA

			if tipo == "#":
				var pared = pared_escena.instantiate()
				pared.position = posicion_global
				add_child(pared)
